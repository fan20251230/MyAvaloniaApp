<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:smartFactoryApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="smartFactoryApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" 
        Height="600" 
        Title="smartFactoryApp" >
       

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
     <Image Source="avares://smartFactoryApp/Assets/factory_plan.png"
           Stretch="None"/>
 
    <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900" >
      
       
        <!-- 机器人运动模式选择 -->
        <StackPanel Canvas.Left="620"
                    Canvas.Top="430"
                    Orientation="Vertical"
                    Spacing="10">

            <RadioButton Content="Move"
                        GroupName="MovementMode"
                        IsChecked="{Binding ContinuousMode, Mode=TwoWay}"/>

            <RadioButton Content="Step"
                    GroupName="MovementMode"
                    IsChecked="True"/>

        </StackPanel>


        <!-- 机器人控制面板：3列 × 4行 -->
        <Grid Canvas.Left="750"
                Canvas.Top="430"
                Width="140"
                Height="150"
                RowDefinitions="*,*,*,*"
                ColumnDefinitions="*,*,*"
                RowSpacing="5"
                ColumnSpacing="5">

    <!-- 第一行 -->
            <Button Grid.Row="0" Grid.Column="0"
                Content="↖" Click="MoveUpLeft_Click"/>
            <Button Grid.Row="0" Grid.Column="1"
                Content="↑" Click="MoveUp_Click"/>
            <Button Grid.Row="0" Grid.Column="2"
                Content="↗" Click="MoveUpRight_Click"/>

    <!-- 第二行 -->
            <Button Grid.Row="1" Grid.Column="0"
                Content="←" Click="MoveLeft_Click"/>
            <Button Grid.Row="1" Grid.Column="1"
                    Content="■"
                    Click="StopRobot_Click"/>
            <Button Grid.Row="1" Grid.Column="2"
                Content="→" Click="MoveRight_Click"/>

    <!-- 第三行 -->
            <Button Grid.Row="2" Grid.Column="0"
                Content="↙" Click="MoveDownLeft_Click"/>
            <Button Grid.Row="2" Grid.Column="1"
                Content="↓" Click="MoveDown_Click"/>
            <Button Grid.Row="2" Grid.Column="2"
                Content="↘" Click="MoveDownRight_Click"/>

    <!-- 第四行：旋转控制 -->
            <Button Grid.Row="3" Grid.Column="0"
                Content="↺" Click="RotateLeft_Click"/>
            <Button Grid.Row="3" Grid.Column="1"
                Content="0°" Click="ResetAngle_Click"/>
            <Button Grid.Row="3" Grid.Column="2"
                Content="↻" Click="RotateRight_Click"/>

        </Grid>
        <!-- 传送带 Start / Stop 控制 -->
        <Grid Canvas.Left="620"
                Canvas.Top="340"
                Width="260"
                Height="40"
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

            <Button Grid.Column="0"
                Content="Start"
                HorizontalAlignment="Stretch"
                Click="Start_Click"/>

            <Button Grid.Column="1"
                Content="Stop"
                HorizontalAlignment="Stretch"
                Click="Stop_Click"/>

        </Grid>
        <!-- Undock 操作反馈 -->
        <TextBlock Canvas.Left="620"
                Canvas.Top="150"
                Width="270"
                Text="{Binding UndockInfo}"
                TextWrapping="Wrap"
                FontSize="14"
                Foreground="Black"/>

        <!-- Dock / Undock 控制 -->
        <StackPanel Canvas.Left="620"
                    Canvas.Top="390"
                    Orientation="Horizontal"
                    Spacing="10">

            <Button Content="Dock"
                    Width="120"
                    Click="Dock_Click"/>

            <Button Content="Undock"
                    Width="120"
                    Click="Undock_Click"/>

        </StackPanel>


        <!-- 红色生产线：使用教授提供的图片 -->
        <Image Canvas.Left="{Binding ProductionRedX}"
                Canvas.Top="{Binding ProductionRedY}"
                Width="110"
                Height="45"
                Source="avares://smartFactoryApp/Assets/production_red_2.png"
                Stretch="Fill"
                RenderTransformOrigin="0%,0%">
            <Image.RenderTransform>
                <RotateTransform Angle="{Binding ProductionRedAngle}"/>
            </Image.RenderTransform>
        </Image>


        <!-- Red Line 碰撞区域：测试用 -->
<Rectangle Canvas.Left="{Binding ProductionRedX}"
           Canvas.Top="{Binding ProductionRedY}"
           Width="110"
           Height="45"
           Stroke="Orange"
           StrokeThickness="2"
           Fill="Transparent"
           IsHitTestVisible="False"
           RenderTransformOrigin="0%,0%">

    <Rectangle.RenderTransform>
        <RotateTransform Angle="{Binding ProductionRedAngle}"/>
    </Rectangle.RenderTransform>

</Rectangle>

        <!-- 蓝色生产线 -->
        <Image Canvas.Left="{Binding ProductionBlueX}"
                Canvas.Top="{Binding ProductionBlueY}"
                Width="110"
                Height="45"
                Source="avares://smartFactoryApp/Assets/production_blue_2.png"
                Stretch="Fill"
                RenderTransformOrigin="0%,0%">
            <Image.RenderTransform>
                <RotateTransform Angle="{Binding ProductionBlueAngle}"/>
            </Image.RenderTransform>
        </Image>





        <!-- Blue Line 碰撞区域 -->
<Rectangle Canvas.Left="{Binding ProductionBlueX}"
           Canvas.Top="{Binding ProductionBlueY}"
           Width="110"
           Height="45"
           Stroke="Orange"
           StrokeThickness="2"
           Fill="Transparent"
           IsHitTestVisible="False"
           RenderTransformOrigin="0%,0%">

    <Rectangle.RenderTransform>
        <RotateTransform Angle="{Binding ProductionBlueAngle}"/>
    </Rectangle.RenderTransform>

</Rectangle>

        <!-- 黄色生产线 -->
        <Image Canvas.Left="{Binding ProductionYellowX}"
                Canvas.Top="{Binding ProductionYellowY}"
                Width="110"
                Height="45"
                Source="avares://smartFactoryApp/Assets/production_yellow_2.png"
                Stretch="Fill"
                RenderTransformOrigin="0%,0%">
            <Image.RenderTransform>
                <RotateTransform Angle="{Binding ProductionYellowAngle}"/>
            </Image.RenderTransform>
        </Image>


<!-- Yellow Line 碰撞区域 -->
<Rectangle Canvas.Left="{Binding ProductionYellowX}"
           Canvas.Top="{Binding ProductionYellowY}"
           Width="110"
           Height="45"
           Stroke="Orange"
           StrokeThickness="2"
           Fill="Transparent"
           IsHitTestVisible="False"/>



        <!-- 绿色生产线 -->
        <Image Canvas.Left="{Binding ProductionGreenX}"
                Canvas.Top="{Binding ProductionGreenY}"
                Width="110"
                Height="45"
                Source="avares://smartFactoryApp/Assets/production_green_2.png"
                Stretch="Fill"
                RenderTransformOrigin="0%,0%">
            <Image.RenderTransform>
                <RotateTransform Angle="{Binding ProductionGreenAngle}"/>
            </Image.RenderTransform>
        </Image>



<!-- Green Line 碰撞区域 -->
<Rectangle Canvas.Left="{Binding ProductionGreenX}"
           Canvas.Top="{Binding ProductionGreenY}"
           Width="110"
           Height="45"
           Stroke="Orange"
           StrokeThickness="2"
           Fill="Transparent"
           IsHitTestVisible="False"/>




        <!-- 四条生产线，共16个积木 -->
        <ItemsControl ItemsSource="{Binding BricksView}"
              Width="900"
              Height="600"
              ZIndex="10">

            <!-- 使用 Canvas 定位积木 -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- 设置每个积木容器的位置 -->
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                    
                    <Setter Property="Canvas.Left"
                        Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"
                        Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>

            <!-- 设置每个积木的颜色和旋转角度 -->
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LegoBrickViewModel">
                    <Rectangle Width="12"
                       Height="12"
                       Fill="{Binding Color}"
                       Stroke="Black"
                       RenderTransformOrigin="50%,50%">

                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="{Binding Angle}"/>
                        </Rectangle.RenderTransform>

                    </Rectangle>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
        <!-- 机器人及其碰撞区域 -->
<Canvas Canvas.Left="{Binding RobotX}"
        Canvas.Top="{Binding RobotY}"
        Width="70"
        Height="50"
        RenderTransformOrigin="50%,50%">

    <!-- 整体旋转 -->
    <Canvas.RenderTransform>
        <RotateTransform Angle="{Binding RobotAngle}"/>
    </Canvas.RenderTransform>

    <!-- 红框：机器人原始图片区域 -->
    <Rectangle Width="70"
               Height="50"
               Stroke="Transparent"
               StrokeThickness="2">

        <Rectangle.Fill>
            <ImageBrush Source="avares://smartFactoryApp/Assets/robot_2.png"/>
        </Rectangle.Fill>

    </Rectangle>

    <!-- 蓝框：机器人碰撞区域（暂定） -->
    <Rectangle Canvas.Left="19"
               Canvas.Top="-2"
               Width="30"
               Height="52"
               Stroke="Blue"
               StrokeThickness="2"
               Fill="Transparent"
               IsHitTestVisible="False"/>

</Canvas>


<!-- 左侧：送往回收 -->
<Image Canvas.Left="88"
       Canvas.Top="40"
       Width="120"
       Height="65"
       Source="avares://smartFactoryApp/Assets/forRecycling.png"
       Stretch="Fill"
       IsHitTestVisible="False"/>

<!-- 右侧：送往客户 -->
<Image Canvas.Left="401"
       Canvas.Top="40"
       Width="120"
       Height="65"
       Source="avares://smartFactoryApp/Assets/toCustomers.png"
       Stretch="Fill"
       IsHitTestVisible="False"/>

        <!-- Delivery Line：工厂顶部中央 -->
        <Image Canvas.Left="212"
                Canvas.Top="40"
                Width="185"
                Height="65"
                Source="avares://smartFactoryApp/Assets/production_delivery_2.png"
                Stretch="Fill"/>


                <!-- Delivery Line 碰撞区域 -->
<Rectangle Canvas.Left="212"
           Canvas.Top="40"
           Width="185"
           Height="65"
           Stroke="Orange"
           StrokeThickness="2"
           Fill="Transparent"
           IsHitTestVisible="False"/>

        <!-- Recycling Line：recycling line -->
        <Image Canvas.Left="240"
                Canvas.Top="280"
                Width="110"
                Height="45"
                Source="avares://smartFactoryApp/Assets/production_recycling_2.png"
                Stretch="Fill"/>

                <!-- Recycling Line 碰撞区域：仅用于可视化 -->
<Rectangle Canvas.Left="240"
           Canvas.Top="280"
           Width="110"
           Height="45"
           Stroke="Orange"
           StrokeThickness="2"
           Fill="Transparent"
           IsHitTestVisible="False"/>

        
        <!-- 机器人位置和角度 -->
        <StackPanel Canvas.Left="620"
            Canvas.Top="240"
            Spacing="4">

            <TextBlock Foreground="Red"
                        FontSize="14"
                        Text="{Binding RobotX, StringFormat='X: {0:F1}'}"/>

            <TextBlock Foreground="Red"
                        FontSize="14"
                        Text="{Binding RobotY, StringFormat='Y: {0:F1}'}"/>

            <TextBlock Foreground="Red"
                       FontSize="14"
                       Text="{Binding RobotAngle, StringFormat='Angle: {0:F1}°'}" />

        </StackPanel>
    </Canvas>
  
  </Grid>

</Window>
