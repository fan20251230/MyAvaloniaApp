<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyAvaloniaApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MyAvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="600"
        Title="MyAvaloniaApp">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Image Source="avares://MyAvaloniaApp/Assets/factory_plan.png"
           Stretch="None"
           HorizontalAlignment="Left" VerticalAlignment="Top" />
 
        <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900" >
            <Rectangle x:Name="robotRectangle"
                        Width="60"
                        Height="40"
                        Canvas.Left="300"
                        Canvas.Top="300"
                        RenderTransformOrigin="50%,50%">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="0" />
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <ImageBrush Source="avares://MyAvaloniaApp/Assets/robot_platform.png"
                                Stretch="UniformToFill" />
                </Rectangle.Fill>
            </Rectangle>
            <!-- 逆时针旋转按钮 -->
            <Button x:Name="RotateLeftButton"
                    Content="↶ Rotate"
                    Canvas.Left="620"
                    Canvas.Top="350"
                    Width="130" />

            <!-- 顺时针旋转按钮 -->
            <Button x:Name="RotateRightButton"
                    Content="Rotate ↷"
                    Canvas.Left="760"
                    Canvas.Top="350"
                    Width="130" />





            <Grid Canvas.Left="620" Canvas.Top="420" Width="270" Height="150" RowDefinitions="*,*,*" ColumnDefinitions="*,*,*">
                <Button x:Name="UpLeftButton" Content="↖" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                
                <Button x:Name="UpButton" Content="Up" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button x:Name="UpRightButton" Content="↗" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button x:Name="LeftButton" Content="Left" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button x:Name="RightButton" Content="Right" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button x:Name="DownLeftButton"
                        Content="↙"
                        Grid.Row="2" Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                <Button x:Name="DownButton"
                        Content="Down"
                        Grid.Row="2" Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                <Button x:Name="DownRightButton"
                        Content="↘"
                        Grid.Row="2" Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            
            
            
        
            </Grid>
        
        </Canvas>
  
    </Grid>

</Window>
