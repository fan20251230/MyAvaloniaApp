<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyAvaloniaApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MyAvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="600"
        Title="MyAvaloniaApp">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Image Source="avares://MyAvaloniaApp/Assets/factory_plan.png"
           Stretch="None"
           HorizontalAlignment="Left" VerticalAlignment="Top" />
 
        <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900" >
            <Rectangle x:Name="robotRectangle"
                        Width="60"
                        Height="40"
                        Canvas.Left="300"
                        Canvas.Top="300">
                <Rectangle.Fill>
                    <ImageBrush Source="avares://MyAvaloniaApp/Assets/robot_platform.png"
                                Stretch="UniformToFill" />
                </Rectangle.Fill>
            </Rectangle>
            <Grid Height="95" Width="160" Canvas.Left="730" Canvas.Top="500">
                <Button x:Name="UpButton" Content="Up" HorizontalAlignment="Center" VerticalAlignment="Top" Width="40" FontSize="16" />
                <Button x:Name="DownButton" Content="Down" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="60" FontSize="16" />
                <Button x:Name="LeftButton" Content="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50" FontSize="16"  />
                <Button x:Name="RightButton" Content="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Width="55" FontSize="16"  />
            </Grid>
        
        </Canvas>
  
    </Grid>

</Window>
